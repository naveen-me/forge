{
  "name": "matrix-reloaded-app",
  "version": "1.0.0",
  "description": "Matrix Reloaded Electron Application",
  "main": "electron-main.js",
  "scripts": {
    "start:backend": "cd backend && npm install && node index.js",
    "start:frontend": "cd frontend && npm install && npm run dev",
    "dev": "concurrently \"npm:start:backend\" \"npm:start:frontend\" \"npm:electron\"",
    "electron": "set NODE_ENV=development&& wait-on http://localhost:5173 && electron .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.12.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^10.0.0",
    "electron": "^28.0.0",
    "wait-on": "^7.2.0"
  }
}
